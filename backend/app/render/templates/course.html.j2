<!DOCTYPE html>
<html lang="{{ language }}">
<head>
<meta charset="utf-8">
<title>{{ document.course_title }}</title>
<style>
  @page { size: {{ page_width }}px {{ page_height }}px; margin: 0; }
  * { box-sizing: border-box; }
  html, body { margin: 0; padding: 0; }
  body {
    font-family: {{ theme.font_family }};
    color: {{ theme.text_color }};
    font-size: {{ theme.base_font_size }}px;
    line-height: {{ theme.base_line_height }};
    -webkit-print-color-adjust: exact;
    print-color-adjust: exact;
  }
  .page {
    position: relative;
    overflow: hidden;
    page-break-after: always;
    break-after: page;
  }
  .page:last-child { page-break-after: auto; break-after: auto; }
  .block { position: absolute; }
  .block > :first-child { margin-top: 0; }
  .block > :last-child { margin-bottom: 0; }

  /* Headings inherit the block's font-size so the layout engine stays authoritative. */
  h1, h2, h3, h4 {
    margin: 0; font-size: inherit; font-weight: inherit; letter-spacing: -0.01em;
    font-family: {{ theme.heading_family }};
    color: {{ theme.heading_ink }};
  }
  p { margin: 0 0 {{ theme.paragraph_spacing_em }}em 0; }
  ul, ol { margin: 0; padding-left: 20px; }
  li { margin-bottom: 4px; }

  .b-cover-accent { border-radius: 4px; }
  .label {
    font-size: 11px; font-weight: 700; letter-spacing: 0.09em;
    text-transform: uppercase; margin-bottom: 8px;
  }
  .title { font-size: 1.05em; font-weight: 700; margin-bottom: 6px; }
  .muted { color: {{ theme.muted_color }}; }
  .caption { font-size: 12.5px; color: {{ theme.muted_color }}; margin-top: 6px; }

  /* Code cell - a Colab-style pair of boxes: light code box, white output box.
     Every size here is a number in app/course/document/code_cell.py; the
     layout engine reserves exactly this much, so change them together. */
  .cell-head {
    height: 30px; display: flex; align-items: center;
    font-size: 11px; font-weight: 700; letter-spacing: 0.09em;
    text-transform: uppercase; color: #5f6368;
  }
  .cell-code {
    border: 1px solid #dadce0; border-radius: 6px; background: #f8f9fa;
    padding: 8px 0;
  }
  .cell-head-static { justify-content: space-between; }
  .cell-head-static .cell-tag { font-weight: 500; letter-spacing: 0; text-transform: none; color: #9aa0a6; }
  .cell-code-static { border-color: #E5E7EB; }
  .cell-row {
    display: flex; min-height: 18px;
    font-family: {{ theme.mono_font_family }}; font-size: 12.5px; line-height: 18px;
    color: #202124;
  }
  .cell-ln {
    flex: 0 0 40px; width: 40px; padding-right: 10px; text-align: right;
    color: #9aa0a6; user-select: none;
  }
  .cell-tx {
    flex: 1 1 auto; min-width: 0; padding-right: 12px;
    white-space: pre-wrap; overflow-wrap: anywhere; tab-size: 4;
  }
  .cell-out {
    margin-top: 8px; border: 1px solid #e0e0e0; border-radius: 6px;
    background: #ffffff; padding: 8px 12px;
  }
  .cell-out-first { margin-top: 0; }
  .cell-out-head {
    height: 20px; line-height: 20px; white-space: nowrap; overflow: hidden;
    font-size: 10.5px; font-weight: 700; letter-spacing: 0.06em; color: #5f6368;
  }
  .cell-out-note { font-weight: 400; letter-spacing: 0; color: #80868b; }
  .cell-out-success .cell-out-head { color: #137333; }
  .cell-out-error .cell-out-head { color: #b3261e; }
  .cell-out-error { background: #fdf6f5; border-color: #f1d4d1; }
  .cell-out-timeout .cell-out-head, .cell-out-stale .cell-out-head { color: #b06000; }
  .cell-out-timeout, .cell-out-stale { background: #fffaf0; border-color: #f3e1b8; }
  .cell-out-body { margin-top: 6px; }
  .cell-out-body pre {
    margin: 0; font-family: {{ theme.mono_font_family }}; font-size: 12.5px;
    line-height: 18px; color: #202124; white-space: pre-wrap; overflow-wrap: anywhere;
  }
  .cell-out-body pre + pre { margin-top: 4px; }
  .cell-out-body .cell-stderr { color: #b3261e; }
  .cell-out-body .cell-none { color: #80868b; font-style: italic; }

  pre {
    margin: 0; white-space: pre-wrap; word-break: break-word;
    font-family: {{ theme.mono_font_family }};
  }
  code { font-family: {{ theme.mono_font_family }}; }

  table { width: 100%; border-collapse: collapse; }
  th, td {
    text-align: left; padding: 8px 10px; vertical-align: top;
    border-bottom: 1px solid {{ theme.table_border }};
  }
  th { font-weight: 700; background: {{ theme.table_header_bg }}; }

  .quiz-q { margin-bottom: 12px; }
  .quiz-q .q { font-weight: 600; }
  .quiz-opts { margin: 4px 0 4px 0; }
  .quiz-answer { font-size: 0.92em; color: {{ theme.muted_color }}; }

  .divider-rule { height: 100%; min-height: 3px; border-radius: 3px; }
  /* Running header/footer come from the template's own DOCX header/footer
     (app.course.templates.docx_parser.style). They are drawn inside the page
     box rather than through Playwright's header/footer templates, because
     those require a non-zero @page margin and this document is full-bleed
     with absolutely positioned blocks. */
  .runhead {
    position: absolute; left: {{ margin_x }}px; right: {{ margin_x }}px;
    top: 28px; font-size: 11px; color: {{ theme.muted_color }};
    border-bottom: 1px solid {{ theme.border_color }}; padding-bottom: 6px;
  }
  .footer {
    position: absolute; left: {{ margin_x }}px; right: {{ margin_x }}px;
    bottom: 34px; font-size: 11px; color: {{ theme.muted_color }};
    display: flex; justify-content: space-between;
    border-top: 1px solid {{ theme.border_color }}; padding-top: 8px;
  }
  .quote-bar { border-left: 4px solid {{ theme.accent_color }}; padding-left: 14px; }
  .figure-box { display: flex; align-items: center; justify-content: center; overflow: hidden; }
  img.figure {
    max-width: 100%; max-height: 100%; width: auto; height: auto;
    display: block; border-radius: inherit;
  }
  .img-missing {
    box-sizing: border-box; width: 100%; display: flex; align-items: center;
    justify-content: center; text-align: center; font-size: 12.5px;
    color: {{ theme.muted_color }}; background: {{ theme.surface_color }};
    border: 1px dashed {{ theme.border_color }}; border-radius: 8px; padding: 0 12px;
  }
  /* A section_intro image + its paired paragraph (see html_renderer.py's
     "section_intro_pair" block) are the one place this document uses real
     CSS float instead of absolute positioning for every child - `overflow:
     hidden` is the float clearfix, so this wrapper's own height (set by the
     outer .block's min-height) still accounts for the floated image. */
  .section-intro-figure { overflow: hidden; }
  .section-intro-img { float: left; margin: 0 16px 10px 0; border-radius: 8px; display: block; }
</style>
</head>
<body>
{% for page in pages %}
<div class="page" style="width:{{ page.width }}px; height:{{ page.height }}px; background:{{ page.background }};">
  {% for b in page.blocks %}
  <div class="block b-{{ b.type }}" style="{{ b.css }}">
    {%- set c = b.content -%}

    {%- if b.type == 'heading' -%}
      {%- set level = c.get('level', 2) -%}
      {%- if level <= 1 -%}<h1>{{ c.get('text', '') }}</h1>
      {%- elif level == 2 -%}<h2>{{ c.get('text', '') }}</h2>
      {%- elif level == 3 -%}<h3>{{ c.get('text', '') }}</h3>
      {%- else -%}<h4>{{ c.get('text', '') }}</h4>{%- endif -%}

    {%- elif b.type == 'paragraph' -%}
      {% for para in b.paragraphs %}<p>{{ para }}</p>{% endfor %}

    {%- elif b.type == 'image' -%}
      {% if b.inline_html %}
        <div class="figure-box cev-pdf-wrap" style="height:{{ b.image_box }}px">{{ b.inline_html | safe }}</div>
      {% elif b.image_src %}
        <div class="figure-box" style="height:{{ b.image_box }}px">
          <img class="figure" src="{{ b.image_src }}" alt="{{ c.get('alt', '') }}">
        </div>
      {% else %}
        {#- A failed/pending generation NEVER shows its internal error here -
           that detail (provider name, HTTP status, raw response body) is
           diagnostic information for course authors, not educational
           content a student should ever see. See c.error for the real
           message, surfaced only in the editor/admin views, never here. -#}
        <div class="img-missing" style="height:{{ b.image_box }}px">Visual unavailable</div>
      {% endif %}
      {% if c.get('caption') and c.get('illustration_style') != 'section_intro' %}<div class="caption">{{ c.get('caption') }}</div>{% endif %}

    {%- elif b.type == 'section_intro_pair' -%}
      <div class="section-intro-figure">
        {% if b.image_src %}
        <img class="section-intro-img" src="{{ b.image_src }}" alt="{{ b.alt }}"
             style="width:{{ b.image_width }}px;height:{{ b.image_height }}px">
        {% endif %}
        {% for para in b.paragraphs %}<p>{{ para }}</p>{% endfor %}
      </div>

    {%- elif b.type == 'quote' -%}
      <div class="quote-bar">
        {% for para in b.paragraphs %}<p>{{ para }}</p>{% endfor %}
        {% if c.get('attribution') %}<div class="caption">— {{ c.get('attribution') }}</div>{% endif %}
      </div>

    {%- elif b.type in ('callout', 'tip', 'warning') -%}
      {% if c.get('title') %}<div class="label" style="color:{{ b.accent }}">{{ c.get('title') }}</div>{% endif %}
      {% for para in b.paragraphs %}<p>{{ para }}</p>{% endfor %}

    {%- elif b.type == 'code' -%}
      {#- Static code: the cell's head + code box, with no Run, status or output.
          Height is reserved by layout.estimate_height via static_code_height. -#}
      <div class="cell-head cell-head-static"><span>{{ b.code.label }}{% if b.code.continued %} (continued){% endif %}</span><span class="cell-tag">Code</span></div>
      <div class="cell-code cell-code-static">
        {% for row in b.code.rows %}<div class="cell-row"><span class="cell-ln">{{ row.n }}</span><span class="cell-tx">{{ row.text }}</span></div>{% endfor %}
      </div>
      {% if c.get('caption') %}<div class="caption">{{ c.get('caption') }}</div>{% endif %}

    {%- elif b.type == 'code_cell' -%}
      {#- Two independent boxes in normal flow: the code box and the output box.
          Heights are reserved by layout._code_cell_height from code_cell.py. -#}
      <div class="cell-head">{{ b.cell.label }} Code{% if b.cell.continued %} (continued){% endif %}</div>
      {% if b.cell.show_code %}
      <div class="cell-code">
        {% for row in b.cell.rows %}<div class="cell-row"><span class="cell-ln">{{ row.n }}</span><span class="cell-tx">{{ row.text }}</span></div>{% endfor %}
      </div>
      {% if c.get('caption') and not b.cell.continued %}<div class="caption">{{ c.get('caption') }}</div>{% endif %}
      {% endif %}
      {% if b.cell.show_output %}
      <div class="cell-out cell-out-{{ b.cell.out.state }}{% if not b.cell.show_code %} cell-out-first{% endif %}">
        <div class="cell-out-head">{{ b.cell.out.label }}{% if b.cell.out.message %} <span class="cell-out-note">&mdash; {{ b.cell.out.message }}</span>{% endif %}</div>
        {% if b.cell.out.has_body %}
        <div class="cell-out-body">
          {% if b.cell.out.stdout %}<pre class="cell-stdout">{{ b.cell.out.stdout }}</pre>{% endif %}
          {% if b.cell.out.stderr %}<pre class="cell-stderr">{{ b.cell.out.stderr }}</pre>{% endif %}
          {% if b.cell.out.is_empty %}<pre class="cell-none">(no output)</pre>{% endif %}
          {% if b.cell.out.truncated %}<pre class="cell-none">Output was cut short.</pre>{% endif %}
        </div>
        {% endif %}
      </div>
      {% endif %}

    {%- elif b.type == 'table' -%}
      <table>
        {% if c.get('columns') %}
        <thead><tr>{% for col in c.get('columns') %}<th style="background:{{ b.accent_soft }}">{{ col }}</th>{% endfor %}</tr></thead>
        {% endif %}
        <tbody>
        {% for row in c.get('rows', []) %}
          <tr>{% for cell in row.get('cells', []) %}<td>{{ cell }}</td>{% endfor %}</tr>
        {% endfor %}
        </tbody>
      </table>
      {% if c.get('caption') %}<div class="caption">{{ c.get('caption') }}</div>{% endif %}

    {%- elif b.type == 'quiz' -%}
      <div class="label" style="color:{{ b.accent }}">{{ c.get('title', 'Knowledge Check') }}</div>
      {% for q in c.get('questions', []) %}
      <div class="quiz-q">
        <div class="q">{{ loop.index }}. {{ q.get('question', '') }}</div>
        {% if q.get('options') %}
        <ol class="quiz-opts" type="A">{% for opt in q.get('options') %}<li>{{ opt }}</li>{% endfor %}</ol>
        {% endif %}
        {% if q.get('answer') %}<div class="quiz-answer"><strong>Answer:</strong> {{ q.get('answer') }}{% if q.get('explanation') %} — {{ q.get('explanation') }}{% endif %}</div>{% endif %}
      </div>
      {% endfor %}

    {%- elif b.type in ('exercise', 'challenge') -%}
      <div class="label" style="color:{{ b.accent }}">{{ c.get('title', 'Exercise') }}{% if c.get('difficulty') %} · {{ c.get('difficulty') }}{% endif %}</div>
      {% if c.get('instructions') %}<p>{{ c.get('instructions') }}</p>{% endif %}
      {% if c.get('steps') %}<ol>{% for step in c.get('steps') %}<li>{{ step }}</li>{% endfor %}</ol>{% endif %}
      {% if c.get('hints') %}<p class="muted"><strong>Hints:</strong></p><ul>{% for hint in c.get('hints') %}<li class="muted">{{ hint }}</li>{% endfor %}</ul>{% endif %}
      {% if c.get('expected_outcome') %}<p class="caption"><strong>Expected outcome:</strong> {{ c.get('expected_outcome') }}</p>{% endif %}

    {%- elif b.type == 'case_study' -%}
      <div class="label" style="color:{{ b.accent }}">{{ c.get('title', 'Case Study') }}</div>
      {% if c.get('context') %}<p><strong>Context.</strong> {{ c.get('context') }}</p>{% endif %}
      {% if c.get('challenge') %}<p><strong>Challenge.</strong> {{ c.get('challenge') }}</p>{% endif %}
      {% if c.get('actions') %}<p><strong>What they did</strong></p><ul>{% for a in c.get('actions') %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}
      {% if c.get('outcome') %}<p><strong>Outcome.</strong> {{ c.get('outcome') }}</p>{% endif %}
      {% if c.get('lessons') %}<p><strong>Lessons</strong></p><ul>{% for l in c.get('lessons') %}<li>{{ l }}</li>{% endfor %}</ul>{% endif %}

    {%- elif b.type == 'story' -%}
      {% if c.get('title') %}<div class="title">{{ c.get('title') }}</div>{% endif %}
      {% for para in b.paragraphs %}<p>{{ para }}</p>{% endfor %}
      {% if c.get('takeaway') %}<p class="caption"><strong>Takeaway:</strong> {{ c.get('takeaway') }}</p>{% endif %}

    {%- elif b.type == 'summary' -%}
      <div class="label" style="color:{{ b.accent }}">{{ c.get('title', 'Summary') }}</div>
      {% if c.get('key_takeaways') %}<ul>{% for item in c.get('key_takeaways') %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}
      {% if c.get('next_steps') %}<p class="muted"><strong>Next</strong></p><ul>{% for item in c.get('next_steps') %}<li class="muted">{{ item }}</li>{% endfor %}</ul>{% endif %}

    {%- elif b.type == 'divider' -%}
      <div class="divider-rule" style="background:{{ b.divider_color }}"></div>

    {%- elif b.type in ('learning_objectives', 'reflection') -%}
      {% if c.get('title') %}<div class="label" style="color:{{ b.accent }}">{{ c.get('title') }}</div>{% endif %}
      {% if c.get('intro') %}<p>{{ c.get('intro') }}</p>{% endif %}
      {% if c.get('items') %}<ul>{% for item in c.get('items') %}<li>{{ item }}</li>{% endfor %}</ul>{% endif %}

    {%- else -%}
      {% for para in b.paragraphs %}<p>{{ para }}</p>{% endfor %}
    {%- endif -%}
  </div>
  {% endfor %}
  {% if page.show_footer and theme.header_line %}
  <div class="runhead">{{ theme.header_line }}</div>
  {% endif %}
  {% if page.show_footer %}
  <div class="footer"><span>{{ theme.footer_line or document.course_title }}</span><span>{{ page.number }} / {{ pages|length }}</span></div>
  {% endif %}
</div>
{% endfor %}
</body>
</html>
