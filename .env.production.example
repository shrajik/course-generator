# Production environment for docker-compose.prod.yml.
# Paste the filled-in version into the GitHub secret PROD_ENV (the deploy workflow writes it to the
# server as .env). NEVER commit real values, and do not reuse your local .env passwords here.

# --- domains ------------------------------------------------------------------------------
# Two names that both point at the server. They must share one parent domain: login cookies are
# SameSite=lax, so a frontend and API on unrelated domains would not stay signed in.
# Testing values use sslip.io, which resolves to the server IP with no registration. For a real
# domain, point two A records at the server and replace both (the deploy rebuilds the frontend).
APP_DOMAIN=courses.45-140-201-44.sslip.io
API_DOMAIN=courses-api.45-140-201-44.sslip.io

# --- required secrets -----------------------------------------------------------------------
# Use hex so nothing needs URL-escaping (the password is placed inside DATABASE_URL):
#   openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=course_app
POSTGRES_DB=course_generator

# Two DIFFERENT long random values:  openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# The first person to register with this email becomes an admin. Register it yourself
# immediately after the first deploy.
INITIAL_ADMIN_EMAIL=

# --- AI providers: copy these from your local .env --------------------------------------------
# AZURE_GPT5_*, AZURE_GPT5_MINI_*, AZURE_GPT55_*, AZURE_EMBEDDING_*, image provider keys,
# OPENAI_API_KEY, IMAGE_PROVIDER, ENABLE_IMAGE_GENERATION, the *_MODEL and *_CONCURRENCY values.
MOCK_OPENAI=false
LOG_LEVEL=INFO

# --- optional: email (verification and notifications) ------------------------------------------
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
