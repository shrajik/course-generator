# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Used for ONE thing only: text embeddings (semantic memory search) - see
# EMBEDDING_MODEL below. NOT used for text generation anymore (writer/editor/
# planner/reviewer/research/deep research all moved to the three Azure
# deployments below) - no Azure embedding deployment was available at
# migration time, so this subsystem was explicitly left on direct OpenAI
# rather than silently guessed at. Leave empty to run with keyword-only
# memory search (semantic search fails soft, same as before) or the offline
# mock client for everything else.
OPENAI_API_KEY=

# Optional: custom / proxy endpoint, embeddings only.
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Azure text models -------------------------------------------------------
# Three separate Azure resources, one per model - each needs its own
# endpoint/key/deployment name below. The *_DEPLOYMENT value must be the
# EXACT deployment name shown in your Azure portal, not the model id - the
# API's own "model" field sends this, never the literal "gpt-5"/"gpt-5-mini"/
# "gpt-5.5" unless that's genuinely what you named the deployment.
# AZURE_*_ENDPOINT is the resource's base compatibility URL, e.g.
# "https://<resource-name>.openai.azure.com/openai/v1/" (confirmed from
# Microsoft's current docs - this "v1" endpoint works with the plain OpenAI
# SDK client unmodified, no api-version query param needed).
AZURE_GPT5_ENDPOINT=
AZURE_GPT5_API_KEY=
AZURE_GPT5_DEPLOYMENT=

AZURE_GPT5_MINI_ENDPOINT=
AZURE_GPT5_MINI_API_KEY=
AZURE_GPT5_MINI_DEPLOYMENT=

AZURE_GPT55_ENDPOINT=
AZURE_GPT55_API_KEY=
AZURE_GPT55_DEPLOYMENT=

# Genuine multi-step/agentic deep research (not just a single shallow search
# on a bigger model) requires this - per Microsoft's docs, pair gpt-5.5 with
# reasoning.effort "high" or "xhigh" for deep-research-style behaviour. Only
# applied to the deep research call, never to a plain chat/structured call.
DEEP_RESEARCH_REASONING_EFFORT=high

# --- Models -----------------------------------------------------------------
# Authoring quality matters most for the writer. Planning, reviewing and
# note-shaping are judgement/formatting tasks a faster tier handles well, which
# is where a large part of the speed-up comes from. Every value here must be
# one of gpt-5 / gpt-5-mini / gpt-5.5 (see the three Azure resources above) -
# if a model is unavailable the client falls back to FALLBACK_MODEL once and
# logs a warning, so these defaults cannot break a deployment.
WRITER_MODEL=gpt-5
EDITOR_MODEL=gpt-5
PLANNER_MODEL=gpt-5-mini
REVIEWER_MODEL=gpt-5-mini
RESEARCH_MODEL=gpt-5-mini
DEEP_RESEARCH_MODEL=gpt-5.5
FALLBACK_MODEL=gpt-5
IMAGE_MODEL=gpt-image-1
IMAGE_SIZE=1024x1024

# --- Image provider -----------------------------------------------------
# gpt-image-1 (OpenAI) is NOT used by default anywhere anymore - the OpenAI
# account's image-generation credit ran out, so every raster illustration
# category defaults to an Azure provider instead. "azure" (default) routes
# through Microsoft Azure AI Foundry's FLUX.2-flex - requires
# AZURE_FLUX_ENDPOINT and AZURE_FLUX_API_KEY below; this is what
# section_intro icons and every other non-textbook illustration use.
# "azure_mai" routes through Microsoft Foundry's MAI-Image-2.6 instead -
# requires the three AZURE_MAI_IMAGE_* settings below (see
# TEXTBOOK_IMAGE_PROVIDER below, which already selects this for textbook-
# style images). "openai" still works if you explicitly set it (e.g. a
# different account/testing), it's just no longer the default. Never falls
# back silently between providers; an unsupported value, or an unconfigured
# Azure deployment, fails with a clear error rather than quietly reaching
# gpt-image-1.
IMAGE_PROVIDER=azure

# Required when IMAGE_PROVIDER=azure (the default). Server-side only - never
# exposed to the frontend, never hardcoded in code.
AZURE_FLUX_ENDPOINT=
AZURE_FLUX_API_KEY=

# Microsoft Foundry MAI-Image-2.6 - this is what textbook-style educational
# images use by default now (see TEXTBOOK_IMAGE_PROVIDER below), so these
# three are effectively required for real (non-mock) course generation.
# Server-side only - never exposed to the frontend, never hardcoded in code.
# AZURE_MAI_IMAGE_ENDPOINT is the FULL generations URL, e.g.
# "https://<resource-name>.services.ai.azure.com/mai/v1/images/generations"
# - not just the resource's base URL. AZURE_MAI_IMAGE_DEPLOYMENT is the
# deployment name you assigned when deploying the model in Foundry (used as
# the API's own "model" request field - never the literal "MAI-Image-2.6").
AZURE_MAI_IMAGE_ENDPOINT=
AZURE_MAI_IMAGE_API_KEY=
AZURE_MAI_IMAGE_DEPLOYMENT=

# Provider used specifically for `illustration_style: "textbook"` images
# (the clean scientific/educational-illustration category - see
# TEXTBOOK_ILLUSTRATION_GUIDANCE). Overrides IMAGE_PROVIDER for this one
# category only; every other illustration (section-intro icons, default-
# style pictures) keeps using IMAGE_PROVIDER above. Defaults to "azure_mai"
# - set to "openai" here to temporarily restore the previous gpt-image-1
# behaviour for controlled testing/comparison.
TEXTBOOK_IMAGE_PROVIDER=azure_mai

# --- Pipeline speed ---------------------------------------------------------
# parallel   - chapters are written concurrently against the blueprint's planned
#              summaries. This is the change that removed ~80% of the wall clock.
# sequential - each chapter waits for the previous chapter's real summary (the
#              original behaviour; keep it to A/B continuity quality).
WRITING_MODE=parallel

# One extra cheap call after a parallel run that checks the whole course for
# repetition and broken transitions between chapters.
CONTINUITY_PASS=true

# Ask the search-enabled research call to return the structured artifact
# directly, instead of shaping the notes in a second call.
SINGLE_CALL_RESEARCH=true

# On review failure, rewrite only the blocks the reviewer objected to rather
# than the whole chapter.
SURGICAL_REVISION=true
MAX_REVIEW_REVISIONS=1

# Input size is latency: how much context the writer and reviewer receive.
RESEARCH_CONTEXT_CHARS=6000
REVIEWER_CONTEXT_CHARS=20000

# fast = model + web_search per chapter (minutes). deep = Deep Research API,
# which costs 5-15 minutes PER CHAPTER - prefer per-chapter opt-in via the
# generate request's deep_research_chapter_ids.
RESEARCH_MODE=fast

# --- Concurrency ------------------------------------------------------------
# Per-phase limits; 0 means "use MAX_CONCURRENCY". Each phase has its own
# limiter that halves itself on a 429 and recovers slowly, so raising these
# degrades gracefully instead of failing. Your provider rate limit is the real
# ceiling here.
MAX_CONCURRENCY=6
WRITER_CONCURRENCY=0
RESEARCH_CONCURRENCY=0
IMAGE_CONCURRENCY=2
MAX_CALL_RETRIES=4
REQUEST_TIMEOUT=900

# --- Behaviour --------------------------------------------------------------
# Force the offline mock client even when an API key is present.
MOCK_OPENAI=false
# Test-only: give each mocked call a fixed cost so concurrency can be measured
# without an API key. Leave at 0 outside tests.
MOCK_LATENCY_MS=0
# Generate images during course generation. They run after the document is
# already readable, so they never block the editor.
ENABLE_IMAGE_GENERATION=true

# --- Storage ----------------------------------------------------------------
DATA_DIR=data
LOG_LEVEL=INFO
APP_ENV=development

# --- PostgreSQL -------------------------------------------------------------
# For local host execution use localhost; Docker Compose overrides the host
# with the postgres service when DATABASE_URL is not explicitly provided.
POSTGRES_DB=course_generator
POSTGRES_USER=course_app
POSTGRES_PASSWORD=course_app_dev
# Local host development only. Leave commented when using Docker Compose;
# Compose supplies the postgres service hostname automatically.
# DATABASE_URL=postgresql+asyncpg://course_app:course_app_dev@localhost:5432/course_generator

# --- Authentication ---------------------------------------------------------
# Required before enabling auth endpoints. Generate strong random values locally;
# never commit real secrets.
JWT_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=1
# Optional development bootstrap: the first account registered with this exact
# email is created with role=admin. Leave empty in normal development.
INITIAL_ADMIN_EMAIL=

# --- Frontend ---------------------------------------------------------------
# Base URL of this backend as seen from the user's BROWSER. Keep it as localhost
# even under docker compose: the Next.js app calls the API client-side.
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
